# ============================================================
# .env.example — Documents which environment variables Netlify
# Functions need at runtime. THIS FILE HAS NO REAL VALUES.
#
# Real values live in Netlify dashboard → Site settings →
# Environment variables. Never commit a populated .env file.
#
# This file is committed so future-you (or a collaborator) knows
# what to configure on a fresh Netlify site.
# ============================================================

# --- PostHog (server-side, used by netlify/functions/posthog-query.js) ---
# Personal API Key, ideally scoped to read-only / query access.
# Generate at: posthog.com → Personal Settings → Personal API Keys.
# Format: phx_<long string>
POSTHOG_PERSONAL_API_KEY=

# Numeric PostHog project ID. Find at:
# posthog.com → Project Settings → Project ID (top of the page)
POSTHOG_PROJECT_ID=

# PostHog API host. Should match the host in js/config.js.
POSTHOG_HOST=https://us.i.posthog.com

# --- Supabase (server-side, used for JWT validation in functions) ---
# Same values as js/config.js. The anon key is also publicly visible
# in the frontend bundle; that's fine — RLS still applies. We pass the
# user's session JWT separately, which is what the function actually
# trusts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
